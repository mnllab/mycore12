    "@types/node": "^26.4.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.5",
    "jsdom": "^25.0.1",
    "playwright": "^1.47.0",
    "typescript": "^5.5.4",
